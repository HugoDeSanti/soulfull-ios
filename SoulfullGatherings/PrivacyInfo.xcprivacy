<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest for Soulfull Gatherings.

	  Covers only what THIS app does. Supabase ships its own manifest inside
	  its frameworks, and Apple merges it into the privacy report — do not
	  restate its collection here. (Stripe left the binary with the client
	  payment rail; see AppFeatures.paymentsEnabled.)

	  Keep this in sync with the App Store Connect privacy questionnaire; a
	  mismatch between the two is a review flag.
	-->

	<!-- No advertising, no cross-app tracking, no tracking SDKs. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Account email, captured in AccountView and stored on `profiles`. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Display name, from onboarding or account creation. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Profile photo (`profiles.avatar_url` → the public `avatars` bucket),
		  chosen through PhotosPicker, downsized on the device and shown beside
		  the member's name in the Community feed. Only the one chosen image is
		  uploaded — the picker runs out of process, so the app never reads the
		  library and no photo-library purpose string is needed.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Supabase auth user id; also the `profiles` primary key. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  No PurchaseHistory: nothing is bought in the app while
		  AppFeatures.paymentsEnabled is false. Bring it back with payments.
		-->

		<!--
		  The retreat application ("Request a place", Features/Retreats/Enquiry/)
		  asks for a phone / WhatsApp number. Sent through send-retreat-enquiry
		  to the team's inbox; not stored in the app's database.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  The same application's optional Instagram handle.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContactInfo</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Free text a member writes to the team: the application's "A little
		  about you" and referral answers, and the optional note on a member
		  report (report-member, member_reports). Never shown to other members.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  The member's friends (`friendships`): Apple's Contacts type covers "a
		  social graph" as well as an address book. The app never reads the
		  phone's contacts.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeContacts</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  The APNs device token (device_tokens), registered only for a signed-in
		  member who allows notifications, used only to deliver likes, and
		  removed on sign-out and account deletion (PushRegistrar).
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!--
		  Practice activity: which session, prompt, exercise or recipe was
		  opened, how much of it was consumed, and when (`practice_plays`, first
		  created in 0008 — `git show d20e3f6:supabase/migrations/`).

		  Declared because it is genuinely collected and linked to the account —
		  it powers "Continue where you left off" and is the record content
		  creator payouts are calculated from. It is NOT tracking: it never
		  leaves our own backend, is not joined to any third-party identity,
		  and no advertising or analytics SDK sees it. Since 2026-09-22 a
		  FINISHED session, movement sequence or recipe (never a journal prompt)
		  is also shown to other members in the Community feed as "<first name>
		  <last initial>. practiced <title>", unless the member turns
		  "Share my practice" off on the You tab. Likes, guide follows and
		  blocks (`member_blocks`, 0028) fall under the same type; friendships
		  are declared as Contacts. Analytics too: the guide dashboard shows a
		  guide how many people their sessions reached (0026).

		  Note what is NOT here: the text of a journal reflection. Only the fact
		  that a prompt was opened is recorded — the writing itself stays on the
		  device (LocalUserStore) and is declared nowhere because it is never
		  collected.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!--
		  Onboarding answers: intentions, body state, practice frequency
		  (`profiles.intentions` / `body_state` / `frequency`). Also the
		  retreat application's date of birth, city ("Where are you based?"),
		  chosen retreat, decision stage and investment band, which go to the
		  team by email. The city is typed, never read from the device, so it
		  is declared here rather than as Coarse Location.

		  Declared as Other rather than Health: these are self-described
		  wellness preferences used to shape content, not medical or fitness
		  measurements. If the questions ever become clinical, move this to
		  NSPrivacyCollectedDataTypeHealth and update the App Store Connect
		  labels to match.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  AppSettings reads and writes UserDefaults on every launch
		  (sg.hasOnboarded, sg.userName, sg.bodyState, sg.frequency,
		  sg.intentions). LocalUserStore also keeps this member's private
		  device-only data there — journal reflections and the retreat trip
		  checklists — namespaced under sg.u.<user id>.
		  CA92.1 = access limited to this app's own defaults.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
