# Xcode. The project is generated by XcodeGen, so none of it is tracked —
# except Package.resolved, the exact versions of every package (project.yml →
# packages), which xcodegen never touches.
*.xcworkspace/
*.xcodeproj/*
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
DerivedData/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# Generated by XcodeGen from project.yml's `info.properties` on every
# `xcodegen generate` — hand-edits are silently reverted. Not tracked, for the
# same reason *.xcodeproj isn't: a fresh clone must run `xcodegen generate`
# before it can build anyway.
SoulfullGatherings/Info.plist
SoulfullGatherings/SoulfullGatherings.entitlements

# Build output
build/
*.o
*.d

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods (not used, but just in case)
Pods/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Claude Code local state (per-machine; never shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Env / secrets
.env
*.pem
Config/Secrets.xcconfig

# Apple private keys (Sign in with Apple .p8, App Store Connect API keys).
# Apple lets you download a .p8 exactly once and it signs auth on your behalf,
# so a committed one has to be revoked in the developer portal, not just
# deleted from the tree. It lives here untracked; its contents go into the
# Supabase function secrets (APPLE_PRIVATE_KEY), never into the repo.
*.p8
AuthKey_*
