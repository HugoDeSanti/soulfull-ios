// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored — never commit real credentials.
// Values come from: Supabase Dashboard → Settings → API

// Host only — no https:// prefix (// is a comment delimiter in xcconfig)
SUPABASE_HOST = YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY
